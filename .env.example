# Copy this file to .env and fill in your own values. Never commit .env.
BARK_SERVER_URL=https://your-bark-server.example
BARK_DEVICE_KEY=REPLACE_WITH_YOUR_DEVICE_KEY
BARK_DEFAULT_GROUP=Codex
BARK_TIMEOUT_MS=10000

# Optional: use an absolute path for a different reminder data directory.
# BARK_DATA_DIR=/ABSOLUTE/PATH/TO/private-bark-data
